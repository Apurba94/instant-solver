[Unit]
Description=Instant Solver web front end (Next.js)
After=network.target instant-solver-api.service

[Service]
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
