# Leave unset to run on the curated archetype corpus alone (no network needed).
# Set it to solve arbitrary problems with the model provider.
ANTHROPIC_API_KEY=

# Model used by the reasoning provider.
CPSOLVE_MODEL=claude-opus-5

# How hard the model thinks: low | medium | high | xhigh | max.
# Higher solves harder problems but costs more per solve.
CPSOLVE_EFFORT=high

# Comma-separated origins allowed to call the API.
CPSOLVE_CORS_ORIGINS=http://localhost:3000

# Where the web app finds the engine (used by the Next.js dev proxy).
CPSOLVE_API_URL=http://127.0.0.1:8000
